<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_school_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">school.assignment</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <!-- My Assignments action (student view — record rules filter by class + published) -->
    <record id="action_school_assignment_my" model="ir.actions.act_window">
        <field name="name">My Assignments</field>
        <field name="res_model">school.assignment</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('state', '=', 'published')]</field>
    </record>

    <!-- Tree -->
    <record id="view_school_assignment_tree" model="ir.ui.view">
        <field name="name">school.assignment.tree</field>
        <field name="model">school.assignment</field>
        <field name="arch" type="xml">
            <tree string="Assignments"
                  decoration-muted="state == 'closed'">
                <field name="assignment_id"/>
                <field name="name"/>
                <field name="course_id"/>
                <field name="class_id"/>
                <field name="teacher_id"/>
                <field name="due_date"/>
                <field name="max_marks"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'published'"
                       decoration-warning="state == 'closed'"/>
            </tree>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_school_assignment_kanban" model="ir.ui.view">
        <field name="name">school.assignment.kanban</field>
        <field name="model">school.assignment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="false">
                <field name="assignment_id"/>
                <field name="name"/>
                <field name="course_id"/>
                <field name="class_id"/>
                <field name="due_date"/>
                <field name="max_marks"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <div class="text-muted small">
                                    <field name="assignment_id"/>
                                </div>
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted small mt-1">
                                    <i class="fa fa-book mr-1" title="Course"/>
                                    <field name="course_id"/>
                                    &amp;nbsp;·&amp;nbsp;
                                    <field name="class_id"/>
                                </div>
                                <div class="mt-2 d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">
                                        <i class="fa fa-calendar mr-1" title="Due Date"/>
                                        <field name="due_date"/>
                                    </span>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'published'"
                                           decoration-warning="state == 'closed'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form -->
    <record id="view_school_assignment_form" model="ir.ui.view">
        <field name="name">school.assignment.form</field>
        <field name="model">school.assignment</field>
        <field name="arch" type="xml">
            <form string="Assignment">
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            class="btn-success"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            attrs="{'invisible': [('state', '!=', 'published')]}"/>
                    <button name="action_close" string="Close" type="object"
                            class="btn-warning"
                            attrs="{'invisible': [('state', '!=', 'published')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_school_assignment_submission)d" type="action"
                                class="oe_stat_button" icon="fa-star"
                                context="{'search_default_assignment_id': active_id}">
                            <field name="submission_count" widget="statinfo" string="Submissions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="assignment_id" class="oe_edit_only"/>
                        <h2 class="text-muted">
                            <field name="assignment_id" readonly="1"/>
                        </h2>
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Assignment Title"/></h1>
                    </div>
                    <group>
                        <group string="Assignment Details">
                            <field name="course_id"/>
                            <field name="class_id"/>
                            <field name="teacher_id"/>
                            <field name="academic_year_id" readonly="1"/>
                        </group>
                        <group string="Marks &amp; Deadline">
                            <field name="due_date"/>
                            <field name="max_marks"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Submissions" name="submissions">
                            <field name="submission_ids">
                                <tree editable="bottom">
                                    <field name="student_id"/>
                                    <field name="marks_obtained"/>
                                    <field name="max_marks" readonly="1"/>
                                    <field name="percentage" readonly="1"/>
                                    <field name="grade" readonly="1"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_school_assignment_search" model="ir.ui.view">
        <field name="name">school.assignment.search</field>
        <field name="model">school.assignment</field>
        <field name="arch" type="xml">
            <search string="Assignments">
                <field name="name"/>
                <field name="assignment_id"/>
                <field name="course_id"/>
                <field name="class_id"/>
                <field name="teacher_id"/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Published" name="published"
                        domain="[('state', '=', 'published')]"/>
                <filter string="Closed" name="closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Course" name="group_course"
                            context="{'group_by': 'course_id'}"/>
                    <filter string="Class" name="group_class"
                            context="{'group_by': 'class_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
