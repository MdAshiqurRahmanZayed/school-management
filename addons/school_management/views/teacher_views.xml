<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="g" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Tree -->
    <record id="view_school_teacher_tree" model="ir.ui.view">
        <field name="name">school.teacher.tree</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <tree string="Teachers"
                  decoration-muted="state in ['resigned','terminated']">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="qualification"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="join_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'on_leave'"
                       decoration-danger="state in ['resigned','terminated']"/>
            </tree>
        </field>
    </record>

    <!-- Kanban — grouped by state, drag-and-drop between columns -->
    <record id="view_school_teacher_kanban" model="ir.ui.view">
        <field name="name">school.teacher.kanban</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="false">
                <field name="photo"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="record.photo.raw_value ? 'data:image/png;base64,' + record.photo.raw_value : '/web/static/img/placeholder.png'"
                                     alt="Photo" class="o_image_64_max"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted small">
                                    <field name="employee_id"/>
                                </div>
                                <div><field name="specialization"/></div>
                                <div><field name="phone"/></div>
                                <div class="mt-1">
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-warning="state == 'on_leave'"
                                           decoration-danger="state in ['resigned','terminated']"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form -->
    <record id="view_school_teacher_form" model="ir.ui.view">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <header>
                    <button name="action_set_active" string="Set Active" type="object"
                            class="btn-success"
                            attrs="{'invisible': [('state', '==', 'active')]}"/>
                    <button name="action_set_on_leave" string="On Leave" type="object"
                            attrs="{'invisible': [('state', 'not in', ['active'])]}"/>
                    <button name="action_resign" string="Resigned" type="object"
                            attrs="{'invisible': [('state', 'not in', ['active','on_leave'])]}"/>
                    <button name="action_terminate" string="Terminate" type="object"
                            class="btn-danger"
                            groups="school_management.group_school_admin"
                            attrs="{'invisible': [('state', '==', 'terminated')]}"/>
                    <button name="action_create_user" string="Create User" type="object"
                            class="btn-primary"
                            groups="school_management.group_school_admin,school_management.group_school_principal"
                            attrs="{'invisible': [('user_id', '!=', False)]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,on_leave,resigned,terminated"/>
                </header>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar"
                           options="{'preview_image': 'photo'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Full Name"/></h1>
                        <h2 class="text-muted">
                            <field name="employee_id" readonly="1"/>
                        </h2>
                    </div>
                    <notebook>
                        <page string="Personal Information" name="personal_info">
                            <group string="Personal Details">
                                <group>
                                    <field name="gender"/>
                                    <field name="date_of_birth"/>
                                    <field name="age" readonly="1"/>
                                </group>
                                <group>
                                    <field name="phone"/>
                                    <field name="email" widget="email"/>
                                </group>
                            </group>
                            <group string="Address">
                                <field name="address" nolabel="1"
                                       placeholder="Full Address"/>
                            </group>
                        </page>
                        <page string="Professional" name="professional">
                            <group>
                                <group string="Qualifications">
                                    <field name="qualification"/>
                                    <field name="specialization"/>
                                    <field name="experience_years"/>
                                </group>
                                <group string="Employment">
                                    <field name="join_date"/>
                                    <field name="user_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"
                                   placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_school_teacher_search" model="ir.ui.view">
        <field name="name">school.teacher.search</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <search string="Teachers">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="specialization"/>
                <field name="qualification"/>
                <filter string="Active" name="active"
                        domain="[('state','=','active')]"/>
                <filter string="On Leave" name="on_leave"
                        domain="[('state','=','on_leave')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Gender" name="group_gender"
                            context="{'group_by': 'gender'}"/>
                    <filter string="Specialization" name="group_specialization"
                            context="{'group_by': 'specialization'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
