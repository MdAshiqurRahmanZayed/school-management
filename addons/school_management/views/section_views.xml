<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_school_section" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">school.section</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Tree -->
    <record id="view_school_section_tree" model="ir.ui.view">
        <field name="name">school.section.tree</field>
        <field name="model">school.section</field>
        <field name="arch" type="xml">
            <tree string="Sections">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="view_school_section_form" model="ir.ui.view">
        <field name="name">school.section.form</field>
        <field name="model">school.section</field>
        <field name="arch" type="xml">
            <form string="Section">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. A, B, Morning"/></h1>
                    </div>
                    <group>
                        <field name="description" placeholder="e.g. Morning Section"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_school_section_search" model="ir.ui.view">
        <field name="name">school.section.search</field>
        <field name="model">school.section</field>
        <field name="arch" type="xml">
            <search string="Sections">
                <field name="name"/>
                <field name="description"/>
            </search>
        </field>
    </record>

</odoo>
