<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_school_classroom" model="ir.actions.act_window">
        <field name="name">Classrooms</field>
        <field name="res_model">school.classroom</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Tree -->
    <record id="view_school_classroom_tree" model="ir.ui.view">
        <field name="name">school.classroom.tree</field>
        <field name="model">school.classroom</field>
        <field name="arch" type="xml">
            <tree string="Classrooms">
                <field name="name"/>
                <field name="room_type" widget="badge"/>
                <field name="building"/>
                <field name="floor"/>
                <field name="capacity"/>
                <field name="class_count"/>
            </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="view_school_classroom_form" model="ir.ui.view">
        <field name="name">school.classroom.form</field>
        <field name="model">school.classroom</field>
        <field name="arch" type="xml">
            <form string="Classroom">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_school_class)d" type="action"
                                class="oe_stat_button" icon="fa-users"
                                context="{'search_default_classroom_id': active_id}">
                            <field name="class_count" widget="statinfo" string="Classes"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Room 101"/></h1>
                    </div>
                    <group>
                        <group string="Room Details">
                            <field name="room_type"/>
                            <field name="capacity"/>
                        </group>
                        <group string="Location">
                            <field name="building"/>
                            <field name="floor"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"
                               placeholder="Facilities, equipment, etc."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_school_classroom_search" model="ir.ui.view">
        <field name="name">school.classroom.search</field>
        <field name="model">school.classroom</field>
        <field name="arch" type="xml">
            <search string="Classrooms">
                <field name="name"/>
                <field name="building"/>
                <filter string="Classroom" name="type_classroom"
                        domain="[('room_type', '=', 'classroom')]"/>
                <filter string="Lab" name="type_lab"
                        domain="[('room_type', '=', 'lab')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Room Type" name="group_room_type"
                            context="{'group_by': 'room_type'}"/>
                    <filter string="Building" name="group_building"
                            context="{'group_by': 'building'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
