<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_school_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">school.academic.year</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Tree -->
    <record id="view_school_academic_year_tree" model="ir.ui.view">
        <field name="name">school.academic.year.tree</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <tree string="Academic Years">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'closed'"/>
            </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="view_school_academic_year_form" model="ir.ui.view">
        <field name="name">school.academic.year.form</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <form string="Academic Year">
                <header>
                    <button name="action_set_active" string="Set Active" type="object"
                            class="btn-success"
                            attrs="{'invisible': [('state', '==', 'active')]}"/>
                    <button name="action_set_closed" string="Close Year" type="object"
                            attrs="{'invisible': [('state', 'in', ['draft', 'closed'])]}"/>
                    <button name="action_set_draft" string="Reset to Draft" type="object"
                            attrs="{'invisible': [('state', '!=', 'closed')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_school_class)d" type="action"
                                class="oe_stat_button" icon="fa-building-o"
                                context="{'search_default_academic_year_id': active_id}">
                            <field name="class_count" widget="statinfo" string="Classes"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. 2025-2026"/></h1>
                    </div>
                    <group>
                        <group string="Duration">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Status">
                            <field name="is_current" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_school_academic_year_search" model="ir.ui.view">
        <field name="name">school.academic.year.search</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <search string="Academic Years">
                <field name="name"/>
                <filter string="Active" name="active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Closed" name="closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
