<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_school_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Tree -->
    <record id="view_school_student_tree" model="ir.ui.view">
        <field name="name">school.student.tree</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <tree string="Students"
                  decoration-muted="state != 'active'">
                <field name="student_id"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="guardian_name"/>
                <field name="enrollment_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'graduated'"
                       decoration-warning="state == 'transferred'"
                       decoration-danger="state == 'withdrawn'"/>
            </tree>
        </field>
    </record>

    <!-- Kanban — grouped by state, drag-and-drop between columns -->
    <record id="view_school_student_kanban" model="ir.ui.view">
        <field name="name">school.student.kanban</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="false">
                <field name="photo"/>
                <field name="name"/>
                <field name="student_id"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="record.photo.raw_value ? 'data:image/png;base64,' + record.photo.raw_value : '/web/static/img/placeholder.png'"
                                     alt="Photo" class="o_image_64_max"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted small">
                                    <field name="student_id"/>
                                </div>
                                <div><field name="phone"/></div>
                                <div class="mt-1">
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-info="state == 'graduated'"
                                           decoration-warning="state == 'transferred'"
                                           decoration-danger="state == 'withdrawn'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form -->
    <record id="view_school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <header>
                    <button name="action_reactivate" string="Reactivate" type="object"
                            class="btn-success"
                            attrs="{'invisible': [('state', '==', 'active')]}"/>
                    <button name="action_graduate" string="Graduate" type="object"
                            attrs="{'invisible': [('state', '!=', 'active')]}"/>
                    <button name="action_transfer" string="Transfer" type="object"
                            attrs="{'invisible': [('state', '!=', 'active')]}"/>
                    <button name="action_withdraw" string="Withdraw" type="object"
                            class="btn-danger"
                            groups="school_management.group_school_admin,school_management.group_school_principal"
                            attrs="{'invisible': [('state', '!=', 'active')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar"
                           options="{'preview_image': 'photo'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Full Name"/></h1>
                        <h2 class="text-muted">
                            <field name="student_id" readonly="1"/>
                        </h2>
                    </div>
                    <notebook>
                        <page string="Personal Information" name="personal_info">
                            <group string="Personal Details">
                                <group>
                                    <field name="gender"/>
                                    <field name="date_of_birth"/>
                                    <field name="age" readonly="1"/>
                                    <field name="blood_group"/>
                                </group>
                                <group>
                                    <field name="phone"/>
                                    <field name="email" widget="email"/>
                                </group>
                            </group>
                            <group string="Address">
                                <field name="address" nolabel="1"
                                       placeholder="Full Address"/>
                            </group>
                        </page>
                        <page string="Guardian" name="guardian">
                            <group>
                                <group>
                                    <field name="guardian_name"/>
                                    <field name="guardian_phone"/>
                                    <field name="guardian_relation"/>
                                </group>
                            </group>
                        </page>
                        <page string="Academic" name="academic">
                            <group>
                                <group>
                                    <field name="class_ids" widget="many2many_tags"/>
                                    <field name="enrollment_date"/>
                                    <field name="user_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"
                                   placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_school_student_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search string="Students">
                <field name="name"/>
                <field name="student_id"/>
                <field name="guardian_name"/>
                <field name="phone"/>
                <filter string="Active" name="active"
                        domain="[('state','=','active')]"/>
                <filter string="Graduated" name="graduated"
                        domain="[('state','=','graduated')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Gender" name="group_gender"
                            context="{'group_by': 'gender'}"/>
                    <filter string="Blood Group" name="group_blood"
                            context="{'group_by': 'blood_group'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
