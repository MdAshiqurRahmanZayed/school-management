<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_school_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Tree -->
    <record id="view_school_class_tree" model="ir.ui.view">
        <field name="name">school.class.tree</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <tree string="Classes"
                  decoration-muted="state != 'active'">
                <field name="full_name"/>
                <field name="academic_year_id"/>
                <field name="class_teacher_id"/>
                <field name="classroom_id"/>
                <field name="student_count"/>
                <field name="capacity"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'completed'"
                       decoration-warning="state == 'archived'"/>
            </tree>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_school_class_kanban" model="ir.ui.view">
        <field name="name">school.class.kanban</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="false">
                <field name="full_name"/>
                <field name="class_teacher_id"/>
                <field name="classroom_id"/>
                <field name="student_count"/>
                <field name="capacity"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="full_name"/>
                                </strong>
                                <div class="text-muted small mt-1">
                                    <i class="fa fa-user-o mr-1" title="Teacher"/>
                                    <field name="class_teacher_id"/>
                                </div>
                                <div class="text-muted small">
                                    <i class="fa fa-map-marker mr-1" title="Classroom"/>
                                    <field name="classroom_id"/>
                                </div>
                                <div class="mt-2 d-flex justify-content-between align-items-center">
                                    <span>
                                        <i class="fa fa-users mr-1" title="Students"/>
                                        <field name="student_count"/>
                                        /
                                        <field name="capacity"/>
                                    </span>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-info="state == 'completed'"
                                           decoration-warning="state == 'archived'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form -->
    <record id="view_school_class_form" model="ir.ui.view">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <header>
                    <button name="action_set_active" string="Set Active" type="object"
                            class="btn-success"
                            attrs="{'invisible': [('state', '==', 'active')]}"/>
                    <button name="action_set_completed" string="Complete" type="object"
                            attrs="{'invisible': [('state', '!=', 'active')]}"/>
                    <button name="action_set_archived" string="Archive" type="object"
                            class="btn-danger"
                            groups="school_management.group_school_admin,school_management.group_school_principal"
                            attrs="{'invisible': [('state', '==', 'archived')]}"/>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Class 6, Grade 10"/></h1>
                        <h2 class="text-muted">
                            <field name="full_name" readonly="1"/>
                        </h2>
                    </div>
                    <notebook>
                        <page string="General" name="general">
                            <group>
                                <group string="Identity">
                                    <field name="section_id"/>
                                    <field name="academic_year_id"/>
                                    <field name="classroom_id"/>
                                </group>
                                <group string="Staff &amp; Capacity">
                                    <field name="class_teacher_id"/>
                                    <field name="capacity"/>
                                    <field name="student_count" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Students" name="students">
                            <field name="student_ids">
                                <tree no_open="1">
                                    <field name="student_id"/>
                                    <field name="name"/>
                                    <field name="gender"/>
                                    <field name="blood_group"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Courses" name="courses">
                            <field name="course_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="teacher_count"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_school_class_search" model="ir.ui.view">
        <field name="name">school.class.search</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <search string="Classes">
                <field name="full_name"/>
                <field name="class_teacher_id"/>
                <field name="academic_year_id"/>
                <field name="classroom_id"/>
                <filter string="Active" name="active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Completed" name="completed"
                        domain="[('state', '=', 'completed')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Academic Year" name="group_year"
                            context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
