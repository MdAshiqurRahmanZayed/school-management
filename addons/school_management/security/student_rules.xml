<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Student restrictions ─────────────────────────────────────────── -->
    <!-- Scoped to group_school_student only.                                -->
    <!-- Because teacher/principal/admin imply student (group hierarchy),    -->
    <!-- bypass rules below (domain 1=1, group_school_teacher) ensure those  -->
    <!-- higher roles are never restricted — Odoo OR's group rules.          -->

    <record id="rule_school_class_student" model="ir.rule">
        <field name="name">Class: Student sees own class only</field>
        <field name="model_id" ref="model_school_class"/>
        <field name="domain_force">[('student_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_student'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_school_course_student" model="ir.rule">
        <field name="name">Course: Student sees own class courses only</field>
        <field name="model_id" ref="model_school_course"/>
        <field name="domain_force">[('class_ids.student_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_student'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_school_assignment_student" model="ir.rule">
        <field name="name">Assignment: Student sees own class published assignments only</field>
        <field name="model_id" ref="model_school_assignment"/>
        <field name="domain_force">[('class_id.student_ids.user_id', '=', user.id), ('state', '=', 'published')]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_student'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_school_assignment_submission_student" model="ir.rule">
        <field name="name">Submission: Student sees and edits own submissions only</field>
        <field name="model_id" ref="model_school_assignment_submission"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_student'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ── Teacher scoped rules ─────────────────────────────────────────── -->
    <!-- Teachers see only records linked to their own teacher profile.       -->
    <!-- OR'd with student rule — teacher user_id won't match student_ids,   -->
    <!-- so effectively only the teacher rule applies for teacher users.      -->

    <record id="rule_school_class_teacher" model="ir.rule">
        <field name="name">Class: Teacher sees own classes only</field>
        <field name="model_id" ref="model_school_class"/>
        <field name="domain_force">[('class_teacher_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_school_course_teacher" model="ir.rule">
        <field name="name">Course: Teacher sees own courses only</field>
        <field name="model_id" ref="model_school_course"/>
        <field name="domain_force">[('teacher_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_school_assignment_teacher" model="ir.rule">
        <field name="name">Assignment: Teacher sees own assignments only</field>
        <field name="model_id" ref="model_school_assignment"/>
        <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_school_assignment_submission_teacher" model="ir.rule">
        <field name="name">Submission: Teacher sees submissions for own assignments only</field>
        <field name="model_id" ref="model_school_assignment_submission"/>
        <field name="domain_force">[('assignment_id.teacher_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ── Principal bypass rules ────────────────────────────────────────── -->
    <!-- Principal implies teacher — without these, principals would be       -->
    <!-- caught by the teacher-scoped rules above. These (1=1) bypass rules  -->
    <!-- are OR'd in, giving principals full visibility.                      -->

    <record id="rule_school_class_principal" model="ir.rule">
        <field name="name">Class: Principal sees all</field>
        <field name="model_id" ref="model_school_class"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_principal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_school_course_principal" model="ir.rule">
        <field name="name">Course: Principal sees all</field>
        <field name="model_id" ref="model_school_course"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_principal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_school_assignment_principal" model="ir.rule">
        <field name="name">Assignment: Principal sees all</field>
        <field name="model_id" ref="model_school_assignment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_principal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_school_assignment_submission_principal" model="ir.rule">
        <field name="name">Submission: Principal sees all</field>
        <field name="model_id" ref="model_school_assignment_submission"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_principal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
